# Copy to .env.local. Validated by src/config/env.ts, which next.config.ts imports.
# These are the development defaults; a production build has none — every key must be
# in the build environment or `next build` fails, because NEXT_PUBLIC_* are baked in.
# ─── ENVIRONMENT ────────────────────────────────────────────────────────────────
# Local Development
NEXT_PUBLIC_APP_NAME=Enterprise
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production Example
# NEXT_PUBLIC_APP_NAME=Enterprise
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
